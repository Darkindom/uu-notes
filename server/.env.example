# 服务器配置
PORT=1717

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this

# 数据库路径
DB_PATH=./data/uu-notes.db

# 允许的域名（小程序的请求域名）
ALLOWED_ORIGINS=https://your-domain.com

# 微信小程序配置（生产环境必填）
# WECHAT_APPID=your-wechat-appid
# WECHAT_SECRET=your-wechat-secret

# 开发环境配置（可选）
# NODE_ENV=development
# DEV_OPENID=xxx
